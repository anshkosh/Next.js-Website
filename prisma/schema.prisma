generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user")
  founderMode   Boolean   @default(true)
  bio           String    @default("")
  location      String    @default("")
  websiteUrl    String    @default("")
  // Optional, private calendar date (YYYY-MM-DD); empty means not provided.
  dateOfBirth   String    @default("")
  notifyStartupReviews Boolean @default(true)
  notifyVoteMilestones Boolean @default(true)
  notifyCommentActivity Boolean @default(true)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions       Session[]
  accounts       Account[]
  startups       Startup[]
  journalPosts   JournalPost[]
  founderEntries FounderJournalEntry[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AdminPasswordResetAudit {
  id                String   @id @default(cuid())
  operatorName      String   @db.VarChar(100)
  targetUserId      String
  targetEmail       String
  reason            String   @db.VarChar(500)
  approvalReference String
  createdAt         DateTime @default(now())

  @@index([targetUserId, createdAt(sort: Desc)])
}

enum StartupStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  REJECTED
  SUSPENDED
}

model Startup {
  id            String        @id @default(cuid())
  founderId     String
  founder       User          @relation(fields: [founderId], references: [id])
  name          String
  slug          String        @unique
  tagline       String        @db.VarChar(120)
  description   String
  websiteUrl    String
  videoUrl      String?
  logoUrl       String?
  galleryImages String[]
  founderName   String
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  status        StartupStatus @default(DRAFT)
  metadata      Json?
  upvoteCount   Int           @default(0)
  downvoteCount Int           @default(0)
  // Stored generated column, maintained by PostgreSQL; never write it from Prisma.
  signalCount   Int           @default(dbgenerated())
  updateCount   Int           @default(0)
  adminNotes    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Founder contact
  startupPhone  String?

  // Core Proposition
  problemStatement  String?
  solutionStatement String?
  targetAudience    String?
  prototypeStatus   String?
  tractionEvidence  String?

  searchVector Unsupported("tsvector")?

  upvotes        Upvote[]
  downvotes      Downvote[]
  slugRedirects  SlugRedirect[]
  founders       StartupFounder[]
  featuredEntry  FeaturedStartup?
  updates        StartupUpdate[]
  comments       Comment[]
  revision       StartupRevision?
  founderEntries FounderJournalEntry[]
  betaTesterProgram BetaTesterProgram?

  @@index([founderId])
  @@index([categoryId])
  @@index([status])
  @@index([upvoteCount(sort: Desc)])
  @@index([signalCount(sort: Desc)])
  @@index([searchVector], type: Gin)
}

// Pending changes never replace the published Startup until a reviewer approves.
model StartupRevision {
  id        String   @id @default(cuid())
  startupId String   @unique
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data      Json
  status    String   @default("PENDING_REVIEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

model MediaUpload {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  bytes     Int
  createdAt DateTime @default(now())
  // Durable erasure queue, kept until object storage confirms removal.
  erasureRequestedAt DateTime?
  erasureAttempts Int @default(0)

  @@index([userId, createdAt])
  @@index([erasureRequestedAt])
}

model StartupFounder {
  id          String  @id @default(cuid())
  startupId   String
  startup     Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  photoUrl    String?
  linkedinUrl String?
  twitterUrl  String?
  sortOrder   Int     @default(0)

  @@index([startupId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconName    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  startups Startup[]
}

model Upvote {
  id              String   @id @default(cuid())
  startupId       String
  startup         Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  fingerprintHash String
  cookieId        String?
  createdAt       DateTime @default(now())

  @@unique([startupId, fingerprintHash])
  @@unique([startupId, cookieId])
  @@index([startupId])
}

model Downvote {
  id              String   @id @default(cuid())
  startupId       String
  startup         Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  fingerprintHash String
  cookieId        String?
  createdAt       DateTime @default(now())

  @@unique([startupId, fingerprintHash])
  @@unique([startupId, cookieId])
  @@index([startupId])
}

model SlugRedirect {
  id        String  @id @default(cuid())
  oldSlug   String  @unique
  startupId String
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model FeaturedStartup {
  id            String    @id @default(cuid())
  startupId     String
  startup       Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  sortOrder     Int       @default(0)
  featuredUntil DateTime?
  createdAt     DateTime  @default(now())

  @@unique([startupId])
  @@index([sortOrder])
}

model BetaTesterProgram {
  id          String               @id @default(cuid())
  startupId   String               @unique
  startup     Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  enabled     Boolean              @default(false)
  description String               @db.VarChar(1000)
  reward      String?              @db.VarChar(500)
  requests    BetaTesterRequest[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model BetaTesterRequest {
  id             String                    @id @default(cuid())
  programId      String
  program        BetaTesterProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  name           String?
  email          String?
  message        String?                    @db.VarChar(500)
  status         BetaTesterRequestStatus    @default(PENDING)
  consentedAt    DateTime
  consentVersion String                    @db.VarChar(40)
  createdAt      DateTime                  @default(now())
  reviewedAt     DateTime?

  @@unique([programId, email])
  @@index([programId, status, createdAt])
}

enum BetaTesterRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum JournalPostStatus {
  DRAFT
  PUBLISHED
}

model JournalCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts JournalPost[]
}

model JournalPost {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  excerpt            String? // Optional manual excerpt; if null, auto-generated at read time
  authorName         String            @default("Anshkosh Team")
  coverImageUrl      String? // Featured/cover image stored in R2
  contentJson        Json? // Quill Delta JSON for editor re-hydration
  contentHtml        String? // Rendered HTML for fast public display
  status             JournalPostStatus @default(DRAFT)
  isFeatured         Boolean           @default(false)
  tags               String[] // Free-form tags
  readingTimeMinutes Int               @default(1)

  // SEO fields
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  canonicalUrl    String?

  // Category
  categoryId String?
  category   JournalCategory? @relation(fields: [categoryId], references: [id])

  // Author (linked to admin user for display, but name is free-text)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([publishedAt(sort: Desc)])
}

model FounderJournalEntry {
  id            String                  @id @default(cuid())
  authorId      String
  author        User                    @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startupId     String?
  startup       Startup?                @relation(fields: [startupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title         String                  @db.VarChar(180)
  body          String                  @db.VarChar(12000)
  contentJson   Json?
  mediaKeys     String[]                @default([])
  prompt        String                  @default("FREE_WRITE") @db.VarChar(30)
  visibility    String                  @default("PRIVATE") @db.VarChar(10)
  milestone     String?                 @db.VarChar(180)
  milestoneDone Boolean                 @default(false)
  publishedAt   DateTime?
  approvedAt    DateTime?
  revision      FounderJournalRevision?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([authorId, updatedAt(sort: Desc)])
  @@index([startupId, visibility, publishedAt(sort: Desc)])
  @@index([mediaKeys], type: Gin)
}

model FounderJournalRevision {
  id            String              @id @default(cuid())
  entryId       String              @unique
  entry         FounderJournalEntry @relation(fields: [entryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data          Json
  status        String              @default("PENDING_REVIEW") @db.VarChar(30)
  version       Int                 @default(1)
  scheduledAt   DateTime?
  reviewerNotes String?             @db.VarChar(2000)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  moderations ContentModeration[]

  @@index([status, scheduledAt])
}

model StartupUpdate {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(200)
  body      String
  imageUrl  String?
  status    CommentStatus @default(APPROVED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moderations ContentModeration[]
  revisions   StartupUpdateRevision[]

  @@index([startupId])
  @@index([createdAt(sort: Desc)])
}

enum CommentStatus {
  PENDING // awaiting admin approval
  APPROVED // visible publicly
  REJECTED // hidden
}

model Comment {
  id        String  @id @default(cuid())
  startupId String
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  // Public commenter (anonymous)
  authorName  String
  authorEmail String // stored privately, never shown publicly
  // Link only when the signed-in account's verified email matches authorEmail.
  authorUserId String?
  body        String        @db.VarChar(2000)
  status      CommentStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?       @db.VarChar(500)
  deletedAt   DateTime?
  deletedBy   String?
  deletionReason String?    @db.VarChar(500)
  deletedFromStatus CommentStatus?

  // Founder reply (one level deep, posted from authenticated dashboard)
  reply     String?   @db.VarChar(2000)
  repliedAt DateTime?
  repliedBy String? // display name shown on reply card (e.g. "Priya · Founder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pendingReply String? @db.VarChar(2000)
  pendingRepliedBy String?
  moderations ContentModeration[]
  revisions   CommentRevision[]
  replyRevisions FounderReplyRevision[]
  staffEvents CommentStaffEvent[]
  // Kept only to match the already-deployed legacy table. The app no longer issues or accepts comment-management links.
  managementTokens CommentManagementToken[]

  @@index([startupId, createdAt(sort: Desc)])
  @@index([status])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@index([deletedAt, createdAt(sort: Desc)])
}

// Immutable snapshots are retained only while their source message exists.
model StartupUpdateRevision {
  id        String   @id @default(cuid())
  updateId  String
  update    StartupUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(200)
  body      String
  imageUrl  String?
  editorId  String?
  createdAt DateTime @default(now())

  @@index([updateId, createdAt(sort: Desc)])
}

model CommentRevision {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorName String
  body      String   @db.VarChar(2000)
  editorId  String?
  createdAt DateTime @default(now())

  @@index([commentId, createdAt(sort: Desc)])
}

model CommentStaffEvent {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String   @db.VarChar(16)
  actorId   String?
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([commentId, createdAt(sort: Desc)])
}

// Body-free audit record retained after an administrator permanently purges a comment.
model CommentPurgeAudit {
  id        String   @id @default(cuid())
  commentId String
  actorId   String?
  reason    String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([commentId, createdAt(sort: Desc)])
}

model FounderReplyRevision {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reply     String   @db.VarChar(2000)
  repliedBy String?
  editorId  String?
  createdAt DateTime @default(now())

  @@index([commentId, createdAt(sort: Desc)])
}

// Legacy table: retained without a migration that would remove production data.
// There are no active routes or server actions that use these tokens.
model CommentManagementToken {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([commentId, expiresAt])
}

// Email-based comment restrictions keep a keyed digest rather than a second raw email copy.
model CommenterBlock {
  id              String   @id @default(cuid())
  emailHash       String   @unique @db.VarChar(64)
  reason          String   @db.VarChar(500)
  sourceCommentId String?
  accountBanId    String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  createdById     String?
  revokedAt       DateTime?
  revokedById     String?

  @@index([revokedAt, expiresAt])
  @@index([sourceCommentId])
  @@index([accountBanId])
}

// Audit metadata for a ban applied through a verified comment identity.
model ModerationAccountBan {
  id              String   @id @default(cuid())
  targetUserId    String
  sourceCommentId String?  @unique
  reason          String   @db.VarChar(500)
  banMarker       String   @unique @db.VarChar(80)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  createdById     String?
  revokedAt       DateTime?
  revokedById     String?

  @@index([targetUserId, revokedAt, expiresAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  unsubscribeTokenHash String? @unique
  consentVersion String?
}

// Internal server-only delivery intent, committed with the business mutation.
model NotificationOutbox {
  id String @id @default(cuid())
  queue String
  name String
  payload Json
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt DateTime?
  createdAt DateTime @default(now())

  @@index([deliveredAt, nextAttemptAt])
}

model ContentModeration {
  id            String                  @id @default(cuid())
  kind          String                  @db.VarChar(20)
  targetId      String
  contentHash   String                  @db.VarChar(64)
  status        String                  @default("PENDING") @db.VarChar(20)
  reasons       String[]                @default([])
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  leaseToken    String?
  checkedAt     DateTime?
  reviewedAt    DateTime?
  reviewedBy    String?
  commentId     String?
  comment       Comment?                @relation(fields: [commentId], references: [id], onDelete: Cascade)
  updateId      String?
  update        StartupUpdate?          @relation(fields: [updateId], references: [id], onDelete: Cascade)
  revisionId    String?
  revision      FounderJournalRevision? @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([kind, targetId])
  @@index([status, nextAttemptAt])
}

model ModerationBudget {
  day      String @id @db.VarChar(10)
  requests Int    @default(0)
}
